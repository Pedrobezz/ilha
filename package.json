{
  "name": "ilha",
  "productName": "Ilha",
  "version": "1.8.2",
  "description": "Ilha dinâmica para o Windows, no topo da tela, estilo Apple",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node build/make-icon.js",
    "dist": "electron-builder --win nsis --publish never",
    "release": "npm run dist && node build/release.js"
  },
  "author": "Pedro Bez",
  "license": "MIT",
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "com.pedrobez.ilha",
    "productName": "Ilha",
    "publish": [
      {
        "provider": "github",
        "owner": "Pedrobezz",
        "repo": "ilha"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "helper.ps1",
      "btbattery.ps1",
      "hidbattery.ps1",
      "renderer/**",
      "package.json"
    ],
    "asarUnpack": [
      "helper.ps1",
      "btbattery.ps1",
      "hidbattery.ps1"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Ilha-Setup-${version}.exe",
      "shortcutName": "Ilha",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Ilha"
    }
  }
}
